{"url": "/privacy", "w": 375, "h": 812, "mode": "full", "sections": [{"id": "6722610f83a465349885c9ce", "theme": "white-bold", "cls": "page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--custom content-width--wide horizontal-alignment--center vertical-alignment--middle white-bold", "style": "padding-top: 82px;", "rect": [0, 741], "minHeight": "0px", "padTop": "82px", "padBot": "0px", "bgc": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "cwPad": ["0px", "0px", "0px", "0px"], "cwStyle": "padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);", "bg": null, "overlay": null, "inFooter": false, "blocks": [{"id": "fe-block-85123685a7dcf306c2ee", "area": "8 / 2 / 10 / 10", "z": "1", "rect": [23, 250, 330, 48], "type": "sqs-block website-component-block html-block", "jc": "center", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "html": "<h2 style=\"white-space:pre-wrap;\" data-fs=\"25.3542px\" data-lh=\"24.8682px\" data-m=\"0px 0px\" data-col=\"rgb(0, 0, 0)\">Privacy Policy</h2>", "htmlRect": [23, 262, 330, 25]}, {"id": "fe-block-ef5debf400994397ed12", "area": "10 / 2 / 14 / 7", "z": "4", "rect": [23, 298, 206, 107], "type": "sqs-block website-component-block html-block", "jc": "flex-start", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "html": "<p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"0px 16px\" data-col=\"rgb(0, 0, 0)\">At Vandra, we value your privacy and are committed to protecting your personal information. This Privacy Policy outlines how we collect, use, and safeguard your data when you visit our website and make a purchase.</p><p class=\"\" data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 0px\" data-col=\"rgb(0, 0, 0)\"></p>", "htmlRect": [23, 298, 206, 107]}], "kind": "fluid", "rows": 27, "rowH": "24px", "gap": "0px", "feH": 659}, {"id": "67acb5fc6f13525b0b90b38c", "theme": "white", "cls": "page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--medium content-width--wide horizontal-alignment--center vertical-alignment--middle white", "style": null, "rect": [741, 1465], "minHeight": "535.92px", "padTop": "0px", "padBot": "0px", "bgc": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "cwPad": ["53.592px", "53.592px", "0px", "0px"], "cwStyle": "", "bg": null, "overlay": null, "inFooter": false, "blocks": [{"id": "fe-block-yui_3_17_2_1_1739371234579_5325", "area": "1 / 2 / 3 / 10", "z": "1", "rect": [23, 795, 330, 1358], "type": "sqs-block website-component-block html-block", "jc": "flex-start", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "html": "<p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"0px 16px\" data-col=\"rgb(0, 0, 0)\"><em data-fw=\"500\">Last Updated:&nbsp;June 2025</em></p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\"><em data-fw=\"500\">Vandra&nbsp;is a brand owned and operated by&nbsp;PFS Enterprise LLC. Your privacy is important to us. This policy explains how we collect, use, and protect your personal information when you interact with our brand, website, or support channels.</em></p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">1. Information We Collect</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We only collect personal information you voluntarily provide to us, such as:</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Contact details (e.g., name, email, phone number)</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Shipping information (e.g., address, country, zip code)</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Product registration details (e.g., model name, date code)</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Communications with customer support</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We do&nbsp;not&nbsp;collect payment information directly.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">2. How We Use Your Information</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We use your information to:</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Provide customer support</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Register your product for safety alerts or recall notifications</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Respond to product-related questions or feedback</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Improve our products and customer experience</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We do&nbsp;not&nbsp;sell, rent, or share your personal data with third parties for marketing purposes.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">3. Data Security</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We use reasonable physical, technical, and administrative safeguards to protect your information. Access is restricted to authorized personnel only.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">4. Your Rights</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">You may request to:</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Access the personal information we have about you</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Correct or update your information</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Have your data deleted from our systems</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Opt&nbsp;out of further communication</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">To exercise these rights, contact us at&nbsp;info@vandrastudios.com.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">5. Children’s Privacy</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">Our website and products are not directed to children under 13 years of age. We do not knowingly collect personal information from children.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">6. Cookies and Tracking</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We do not currently use cookies or tracking tools on our website. If this changes in the future, we will update this policy accordingly.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">7. Changes to This Policy</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">We may update this Privacy Policy from time to time. The latest version will always be posted on this page with a revised date.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">8. Contact Us</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">For questions or concerns about your privacy, please contact:<br>info@vandrastudios.com</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 0px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p>", "htmlRect": [23, 795, 330, 1358]}], "kind": "fluid", "rows": 2, "rowH": "673.5px", "gap": "11px", "feH": 1358}, {"id": "6722610f83a465349885c9c7", "theme": "white-bold", "cls": "page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--custom content-width--wide horizontal-alignment--center vertical-alignment--middle white-bold", "style": "min-height: 1vh;", "rect": [2206, 388], "minHeight": "0px", "padTop": "0px", "padBot": "0px", "bgc": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "cwPad": ["0.812px", "0.812px", "0px", "0px"], "cwStyle": "padding-top: calc(1vmax / 10); padding-bottom: calc(1vmax / 10);", "bg": null, "overlay": null, "inFooter": true, "blocks": [{"id": "fe-block-yui_3_17_2_1_1747769784074_8896", "area": "3 / 2 / 5 / 10", "z": "6", "rect": [23, 2255, 330, 48], "type": "sqs-block website-component-block newsletter-block", "jc": "flex-start", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "form": {"fields": [{"cls": "newsletter-form-field-wrapper email required", "label": "Email Address", "rect": [0, 1783, 0, 0], "inputs": [{"tag": "INPUT", "type": "email", "name": "email", "ph": "Email Address", "rect": [0, 0, 0]}]}], "btn": {"text": "Sign up", "fs": "13.4666px", "pad": "22.4px 32px", "bg": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "radius": "300px", "border": "1px solid rgb(0, 0, 0)", "rect": [0, 0]}, "input": {"fs": "15.8051px", "pad": "22.4px 32px", "bg": "rgb(255, 255, 255)", "border": "1px solid rgba(0, 0, 0, 0.12)", "radius": "0px", "h": 0}, "label": {"fs": "15.8051px", "fw": "500", "mb": "