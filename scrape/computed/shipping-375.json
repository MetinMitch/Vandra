{"url": "/shipping", "w": 375, "h": 812, "mode": "full", "sections": [{"id": "6722611283a465349885cad5", "theme": "white-bold", "cls": "page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--custom content-width--wide horizontal-alignment--center vertical-alignment--middle white-bold", "style": "padding-top: 82px;", "rect": [0, 586], "minHeight": "0px", "padTop": "82px", "padBot": "0px", "bgc": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "cwPad": ["0px", "0px", "0px", "0px"], "cwStyle": "padding-top: calc(0vmax / 10); padding-bottom: calc(0vmax / 10);", "bg": null, "overlay": null, "inFooter": false, "blocks": [{"id": "fe-block-bfcf2cddf0b8e97d28d0", "area": "8 / 2 / 10 / 10", "z": "1", "rect": [23, 250, 330, 48], "type": "sqs-block website-component-block html-block", "jc": "center", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "html": "<h2 style=\"white-space:pre-wrap;\" data-fs=\"25.3542px\" data-lh=\"24.8682px\" data-m=\"0px 0px\" data-col=\"rgb(0, 0, 0)\">Shipping and Return</h2>", "htmlRect": [23, 262, 330, 25]}, {"id": "fe-block-2dca0896eab35e59a6b1", "area": "10 / 2 / 17 / 7", "z": "4", "rect": [23, 298, 206, 168], "type": "sqs-block website-component-block html-block", "jc": "flex-start", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "html": "<p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"0px 0px\" data-col=\"rgb(0, 0, 0)\">At Vandra, we strive to provide a seamless shopping experience, ensuring you receive your supplements promptly and can shop with confidence.</p>", "htmlRect": [23, 298, 206, 52]}], "kind": "fluid", "rows": 21, "rowH": "24px", "gap": "0px", "feH": 504}, {"id": "67acb66e1e35a3572c9a9e50", "theme": "white", "cls": "page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--medium content-width--wide horizontal-alignment--center vertical-alignment--middle white", "style": null, "rect": [586, 805], "minHeight": "535.92px", "padTop": "0px", "padBot": "0px", "bgc": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "cwPad": ["53.592px", "53.592px", "0px", "0px"], "cwStyle": "", "bg": null, "overlay": null, "inFooter": false, "blocks": [{"id": "fe-block-yui_3_17_2_1_1739371234579_8215", "area": "1 / 2 / 3 / 10", "z": "1", "rect": [23, 640, 330, 698], "type": "sqs-block website-component-block html-block", "jc": "flex-start", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "html": "<p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"0px 16px\" data-col=\"rgb(0, 0, 0)\">Shipping</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">All Vandra products are&nbsp;fulfilled by Amazon (FBA). When you place an order, Amazon handles the entire process — from warehousing to delivery. Shipping times, options, and fees are determined by Amazon at checkout based on your location and selected delivery method.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Standard delivery is typically completed within&nbsp;2–5 business days&nbsp;within the continental U.S.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Expedited and priority options may be available at checkout.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">•&nbsp;Tracking information will be provided via Amazon once your order ships.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">If you have any issues with shipping or delivery, please contact&nbsp;Amazon Customer Servicedirectly through your order history.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">Returns</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">Vandra products purchased through Amazon are subject to&nbsp;Amazon’s return and refund policies. Most items are eligible for return within&nbsp;30 days of delivery&nbsp;if they are unused and in original condition.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">To initiate a return:</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">1.&nbsp;Go to&nbsp;Your Orders&nbsp;on your Amazon account</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">2.&nbsp;Select the item you wish to return</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">3.&nbsp;Follow the on-screen instructions to process the return through Amazon</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">If your item arrives damaged or defective, Amazon will typically offer a replacement or full refund. For assistance, please contact Amazon Support through your account.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 16px\" data-col=\"rgb(0, 0, 0)\">Questions or Issues?</p><p class=\"\" style=\"white-space:pre-wrap;\" data-fs=\"11px\" data-lh=\"13px\" data-m=\"16px 0px\" data-col=\"rgb(0, 0, 0)\">If you experience a product-related issue (such as a missing part or safety concern), you can also reach out to us directly at&nbsp;info@vandrastudios.com. Please include your Amazon order number and a description of the issue so we can assist further.</p>", "htmlRect": [23, 640, 330, 698]}], "kind": "fluid", "rows": 2, "rowH": "343.5px", "gap": "11px", "feH": 698}, {"id": "6722610f83a465349885c9c7", "theme": "white-bold", "cls": "page-section full-bleed-section layout-engine-section background-width--full-bleed section-height--custom content-width--wide horizontal-alignment--center vertical-alignment--middle white-bold", "style": "min-height: 1vh;", "rect": [1391, 388], "minHeight": "0px", "padTop": "0px", "padBot": "0px", "bgc": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "cwPad": ["0.812px", "0.812px", "0px", "0px"], "cwStyle": "padding-top: calc(1vmax / 10); padding-bottom: calc(1vmax / 10);", "bg": null, "overlay": null, "inFooter": true, "blocks": [{"id": "fe-block-yui_3_17_2_1_1747769784074_8896", "area": "3 / 2 / 5 / 10", "z": "6", "rect": [23, 1440, 330, 48], "type": "sqs-block website-component-block newsletter-block", "jc": "flex-start", "ai": "normal", "fd": "column", "pad": "0px", "disp": "block", "form": {"fields": [{"cls": "newsletter-form-field-wrapper email required", "label": "Email Address", "rect": [0, 968, 0, 0], "inputs": [{"tag": "INPUT", "type": "email", "name": "email", "ph": "Email Address", "rect": [0, 0, 0]}]}], "btn": {"text": "Sign up", "fs": "13.4666px", "pad": "22.4px 32px", "bg": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "radius": "300px", "border": "1px solid rgb(0, 0, 0)", "rect": [0, 0]}, "input": {"fs": "15.8051px", "pad": "22.4px 32px", "bg": "rgb(255, 255, 255)", "border": "1px solid rgba(0, 0, 0, 0.12)", "radius": "0px", "h": 0}, "label": {"fs": "15.8051px", "fw": "500", "mb": "0px"}, "fieldGap": "0px/5px", "formRect": [968, 0]}, "newsletter": {"title": "Newsletter", "titleFs": "27px", "titleLh": "32.4px"